# Dependencies
node_modules/
.pnp
.pnp.js

# Build and production output
dist/
build/
out/
.next/

# Environment and secrets
.env
.env.*
*.pem
*.key
*.cert
*.crt

# Safe example files are allowed:
!.env.example
!.env.*.example

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Tooling and compiler caches
.cache/
.vite/
.eslintcache
.stylelintcache
.turbo/
*.tsbuildinfo

# Temporary and upload directories
tmp/
temp/
uploads/

# Operating system artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

