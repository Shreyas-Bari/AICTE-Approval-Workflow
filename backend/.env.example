# ==============================================================================
# AICTE Approval Workflow Automation - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Environment Mode ('development' | 'test' | 'production')
NODE_ENV=development

# HTTP Server Port
PORT=5000

# Client Application URL (Allowed CORS Origin & CSRF Allowed Origin)
CLIENT_URL=http://localhost:5173

# Relational Database Connections (Neon PostgreSQL)
# Both endpoints target the Neon 'development' branch for local development.
#
# 1. DATABASE_URL: Neon Connection Pooler (PgBouncer) for application runtime queries.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. DIRECT_URL: Neon Compute Node (Direct unpooled) for Prisma CLI migrations.
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Authentication & Cryptographic Configuration (Decision Q-01 Option B)
# ==============================================================================
# Secrets must be at least 32 characters long. In production, secure random keys must be set.
JWT_ACCESS_SECRET=replace_with_min_32_character_jwt_access_secret_for_production
JWT_REFRESH_SECRET=replace_with_min_32_character_jwt_refresh_secret_for_production
CSRF_SECRET=replace_with_min_32_character_csrf_hmac_secret_for_production

# Provisional Token Lifetimes (in seconds) - subject to operational tuning
# Default: 15 minutes (900s) for access tokens, 7 days (604800s) for refresh tokens
ACCESS_TOKEN_LIFETIME_SEC=900
REFRESH_TOKEN_LIFETIME_SEC=604800
