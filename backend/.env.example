# ==============================================================================
# AICTE Approval Workflow Automation - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Environment Mode ('development' | 'test' | 'production')
NODE_ENV=development

# HTTP Server Port
PORT=5000

# Client Application URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# Relational Database Connection (Neon PostgreSQL)
# Placeholder format for future database integration. Leave blank or configure
# local PostgreSQL instance once schema reconciliation is complete.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/aicte_db?sslmode=require
