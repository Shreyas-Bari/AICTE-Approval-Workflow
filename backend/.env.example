# ==============================================================================
# AICTE Approval Workflow Automation - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Environment Mode ('development' | 'test' | 'production')
NODE_ENV=development

# HTTP Server Port
PORT=5000

# Client Application URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# Relational Database Connections (Neon PostgreSQL)
# Both endpoints target the Neon 'development' branch for local development.
#
# 1. DATABASE_URL: Neon Connection Pooler (PgBouncer) for application runtime queries.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. DIRECT_URL: Neon Compute Node (Direct unpooled) for Prisma CLI migrations.
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
